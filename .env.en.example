# ===== English Bot Settings =====
# Copy this file to .env.en and fill in the actual values

APP_LANG=en

# Slack App (English Bot) credentials
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target channel ID (e.g., C0123456789)
CHANNEL_ID=C0123456789

# Bot's Slack User ID (e.g., U0123456789)
BOT_USER_ID=U0123456789

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Model (optional, default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Port for Bolt to listen on (optional, default: 3001 for English bot)
PORT=3001

# Cron schedule (optional, default: 16:00 JST daily)
CRON_SCHEDULE=0 16 * * *
