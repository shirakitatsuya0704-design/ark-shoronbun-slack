{
  "name": "ark_news_review",
  "version": "1.0.0",
  "description": "Slack Bot for automated essay correction (Japanese & English)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node -r ts-node/register src/index.ts",
    "start:ja": "APP_LANG=ja node -r ts-node/register src/index.ts",
    "start:en": "APP_LANG=en PORT=3001 node -r ts-node/register src/index.ts",
    "dev:ja": "APP_LANG=ja ts-node src/index.ts",
    "dev:en": "APP_LANG=en PORT=3001 ts-node src/index.ts",
    "post:ja": "APP_LANG=ja ts-node src/post-now.ts",
    "post:en": "APP_LANG=en ts-node src/post-now.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.0",
    "@slack/bolt": "^4.7.2",
    "axios": "^1.16.1",
    "dotenv": "^16.6.1",
    "node-cron": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/node-cron": "^3.0.11"
  }
}
