# ===== 日本語Bot 設定ファイル =====
# このファイルを .env.ja にコピーして実際の値を記入してください

APP_LANG=ja

# Slack App (日本語Bot用) の認証情報
# https://api.slack.com/apps で取得
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 投稿先チャンネルID（例: C0123456789）
# チャンネルを右クリック > リンクをコピー > URLの末尾が Channel ID
CHANNEL_ID=C0123456789

# Bot の Slack ユーザーID（例: U0123456789）
# Slack App の "App Home" ページで確認、または OAuth 完了後に apps.auth.test API で取得
BOT_USER_ID=U0123456789

# Anthropic API キー
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# 使用モデル（省略可、デフォルト: claude-sonnet-4-6）
ANTHROPIC_MODEL=claude-sonnet-4-6

# Bolt が Listen するポート（省略可、デフォルト: 3000）
PORT=3000

# スケジュール（省略可、デフォルト: 毎日16時 JST）
CRON_SCHEDULE=0 16 * * *
